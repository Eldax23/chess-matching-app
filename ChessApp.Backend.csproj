<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ChessApp.Backend</RootNamespace>
    <AssemblyName>ChessApp.Backend</AssemblyName>
    <!-- The test project lives under tests/; keep its files out of this project's globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity Framework Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.0" />
    <!-- Maps entity/property names to snake_case column/table names, matching
         the check constraints and index filters below (e.g. "proposer_id",
         "is_available") which are raw SQL fragments EF does not translate -
         without this, EF's default PascalCase columns wouldn't match and
         every migration touching them would fail at runtime. -->
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />

    <!-- Authentication & Security -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- BCrypt.Net-Next: replaces the previous unsalted SHA-512 password hashing.
         See AuthService.cs HashPassword/VerifyPassword. -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- JwtBearer 10.0.1 shipped with a known bug (dotnet/aspnetcore#64932):
         its declared minimum for Microsoft.IdentityModel.Protocols.OpenIdConnect
         (>= 8.0.1) was too low and caused a *runtime* MethodNotFoundException on
         login, not a build failure - restore/build would succeed and auth would
         still be broken. Using 10.0.12 here (declares >= 8.19.2) plus explicitly
         pinning System.IdentityModel.Tokens.Jwt to 8.20.0 avoids relying on
         transitive resolution picking a safe version by luck. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.20.0" />
    
    <!-- Validation -->
    <PackageReference Include="FluentValidation" Version="11.8.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.8.1" />

    <!-- Swagger / OpenAPI - Program.cs calls AddSwaggerGen/UseSwagger/UseSwaggerUI
         (Swashbuckle) and .WithOpenApi() on a minimal API endpoint
         (Microsoft.AspNetCore.OpenApi); neither package was referenced before. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />

    <!-- Note: AutoMapper was removed. It was injected into UserService but
         .Map() was never actually called anywhere (dead code), and current
         versions carry a high-severity DoS advisory (GHSA-rvv3-g6hj-g44x);
         the patched versions (15.1.1+/16.1.1+) also moved to a commercial
         license as of v15. Every other service in this codebase already maps
         DTOs by hand (see ProposalService.cs's MapTo*Response methods) -
         follow that pattern if mapping is needed again. -->

    <!-- Logging & Diagnostics -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />

    <!-- Object storage for profile photos: S3-compatible client, pointed at
         Cloudflare R2 in production (see Storage:S3 in appsettings.json and
         Program.cs). Development uses LocalPhotoStorageService instead -
         no package or credentials needed there. -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.3" />

    <!-- Note: SignalR (AddSignalR, MapHub, Hub, IHubContext) is part of the
         ASP.NET Core shared framework since .NET Core 3 - no package needed.
         The old standalone "Microsoft.AspNetCore.SignalR" package (pre-3.0)
         was removed here; referencing it against net8.0 would fail restore. -->

    <!-- Geospatial -->
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <!-- "NetTopologySuite.Geometries.Extended" was removed: no such package
         exists on nuget.org (NU1101). Everything used here - GeometryFactory,
         Point, Coordinate, PrecisionModel - lives in the base package. -->

    <!-- Note: StackExchange.Redis and Polly were referenced but never used
         anywhere in the codebase - removed. Re-add when actually implementing
         Redis-backed rate limiting or resilience policies (see NEXT_STEPS_PLAN.md BE-6). -->

    <!-- Testing (optional, for later) -->
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="Moq" Version="4.20.70" />
  </ItemGroup>

</Project>
