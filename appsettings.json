{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=chess_app;Username=postgres;Password=password;",
    "AzureBlobStorage": "DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=yourkey;EndpointSuffix=core.windows.net"
  },
  "Jwt": {
    "SecretKey": "your-super-secret-key-min-32-characters-long-for-hs256",
    "Issuer": "chess-app-api",
    "Audience": "chess-app-mobile",
    "ExpirationMinutes": 60
  },
  "Azure": {
    "StorageAccount": "yourstorageaccount",
    "StorageKey": "yourkey",
    "BlobContainerName": "chess-app-photos"
  },
  "Api": {
    "MaxUploadSizeMb": 5,
    "MaxPhotoWidth": 1024,
    "MaxPhotoHeight": 1024
  },
  "Lichess": {
    "ClientId": "blitzmate",
    "RedirectUri": "com.chessmatchingapp://oauth/lichess",
    "UserAgent": "BlitzMate/0.1",
    "SyncIntervalHours": 12
  },
  "ChessCom": {
    "UserAgent": "BlitzMate/0.1",
    "SyncIntervalHours": 12
  },
  "Features": {
    "ProposalExpirationHours": 24,
    "DefaultSearchRadiusKm": 10,
    "MaxNearbyUsersLimit": 100,
    "AvailabilityExpirationHours": 4
  },
  "AllowedHosts": "*"
}
